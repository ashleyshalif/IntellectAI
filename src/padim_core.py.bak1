"""
padim_core.py
Core PaDiM (Patch Distribution Modeling) engine.
Shared by train.py (fitting) and app.py (inference).

Reference idea: freeze a pretrained ResNet18, pull mid-level feature maps,
embed each spatial location, fit a Gaussian (mean + covariance) per location
using ONLY defect-free ("good") training images, then score new images by
Mahalanobis distance from that learned distribution.
"""

import torch
import torch.nn.functional as F
import torchvision.transforms as T
from torchvision.models import resnet18, ResNet18_Weights
import numpy as np
from PIL import Image
import pickle
import os

IMG_SIZE = 224
DEVICE = torch.device("cuda" if torch.cuda.is_available() else "cpu")

# Random dimensionality reduction (standard PaDiM trick): the raw concatenated
# embedding has 448 channels, which makes each per-location covariance matrix
# 448x448 -> huge (~2.4GB saved per category). Keeping a fixed random subset
# of REDUCED_DIM channels collapses that to REDUCED_DIM x REDUCED_DIM with
# minimal loss of discriminative power. Seed is fixed so train-time and
# inference-time indices always match.
REDUCED_DIM = 80
RANDOM_SEED = 1024

# Standard ImageNet normalization since we use an ImageNet-pretrained backbone
TRANSFORM = T.Compose([
    T.Resize((IMG_SIZE, IMG_SIZE)),
    T.ToTensor(),
    T.Normalize(mean=[0.485, 0.456, 0.406], std=[0.229, 0.224, 0.225]),
])


class FeatureExtractor:
    """Wraps a frozen ResNet18 and taps layer1/layer2/layer3 feature maps."""

    def __init__(self, device=DEVICE):
        self.device = device
        weights = ResNet18_Weights.IMAGENET1K_V1
        net = resnet18(weights=weights)
        net.eval()
        for p in net.parameters():
            p.requires_grad = False
        self.net = net.to(device)

        self._features = {}
        net.layer1.register_forward_hook(self._hook("layer1"))
        net.layer2.register_forward_hook(self._hook("layer2"))
        net.layer3.register_forward_hook(self._hook("layer3"))

        # Fixed random channel subset -- same seed means train.py and app.py
        # always pick the identical 80 channels out of 448.
        rng = np.random.RandomState(RANDOM_SEED)
        self.channel_indices = rng.choice(448, size=REDUCED_DIM, replace=False)

    def _hook(self, name):
        def fn(_module, _input, output):
            self._features[name] = output.detach()
        return fn

    @torch.no_grad()
    def __call__(self, x: torch.Tensor) -> torch.Tensor:
        """
        x: (B, 3, H, W) normalized batch.
        Returns embedding volume (B, REDUCED_DIM, H', W') -- the three ResNet
        layers are concatenated to 448 channels (the standard PaDiM
        multi-scale embedding trick), then reduced to a fixed random subset
        of REDUCED_DIM channels to keep the saved model size small.
        """
        x = x.to(self.device)
        self._features = {}
        _ = self.net(x)

        f1 = self._features["layer1"]  # (B, 64,  56, 56)
        f2 = self._features["layer2"]  # (B, 128, 28, 28)
        f3 = self._features["layer3"]  # (B, 256, 14, 14)

        target_h, target_w = f1.shape[2], f1.shape[3]
        f2_up = F.interpolate(f2, size=(target_h, target_w), mode="nearest")
        f3_up = F.interpolate(f3, size=(target_h, target_w), mode="nearest")

        embedding = torch.cat([f1, f2_up, f3_up], dim=1)  # (B, 448, 56, 56)
        embedding = embedding[:, self.channel_indices, :, :]  # (B, REDUCED_DIM, 56, 56)
        return embedding


def load_image(path: str) -> torch.Tensor:
    img = Image.open(path).convert("RGB")
    return TRANSFORM(img)


def fit_gaussian(embeddings: np.ndarray, eps: float = 0.01):
    """
    embeddings: (N, C, H, W) numpy array of training embeddings ("good" images only)
    Returns: mean (C, H*W), inv_covariance (H*W, C, C)
    A small identity*eps is added to each covariance for numerical stability
    (standard PaDiM regularization -- without it, matrices are near-singular).
    """
    n, c, h, w = embeddings.shape
    embeddings = embeddings.reshape(n, c, h * w)

    mean = np.mean(embeddings, axis=0)  # (C, H*W)

    inv_covariance = np.zeros((h * w, c, c), dtype=np.float32)
    identity = np.identity(c) * eps

    for loc in range(h * w):
        patch = embeddings[:, :, loc]  # (N, C)
        cov = np.cov(patch, rowvar=False) + identity
        inv_covariance[loc] = np.linalg.inv(cov)

    return mean, inv_covariance, (h, w)


def mahalanobis_score_map(embedding: np.ndarray, mean: np.ndarray, inv_cov: np.ndarray, hw):
    """
    embedding: (C, H, W) for a single image
    Returns anomaly score map of shape (H, W)
    """
    h, w = hw
    c = embedding.shape[0]
    embedding = embedding.reshape(c, h * w)

    dist_map = np.zeros(h * w, dtype=np.float32)
    for loc in range(h * w):
        delta = embedding[:, loc] - mean[:, loc]
        dist_map[loc] = np.sqrt(delta @ inv_cov[loc] @ delta)

    return dist_map.reshape(h, w)


def save_stats(path: str, mean, inv_cov, hw):
    with open(path, "wb") as f:
        pickle.dump({"mean": mean, "inv_cov": inv_cov, "hw": hw}, f, protocol=pickle.HIGHEST_PROTOCOL)


def load_stats(path: str):
    with open(path, "rb") as f:
        d = pickle.load(f)
    return d["mean"], d["inv_cov"], d["hw"]
